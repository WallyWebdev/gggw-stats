---
import 'leaflet/dist/leaflet.css';
import '../styles/global.css';
import data from '../data/walks.json';

const { meta, countries, walks } = data;
const mappedWalks = walks.filter((walk) => walk.location);
const shortWalks = walks.filter((walk) => walk.shortWalk.toLowerCase() === 'yes').length;
const accessibleWalks = walks.filter((walk) => walk.accessible.toLowerCase() === 'yes').length;
const leadingCountry = countries[0];
const updated = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(meta.scrapedAt));
const safeJson = JSON.stringify(mappedWalks).replaceAll('<', '\\u003c');
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Great Global Greyhound Walk 2026 registered walk locations',
  description: `A visualisation of ${meta.walkCount} publicly listed Great Global Greyhound Walk events across ${meta.countryCount} countries and territories.`,
  url: Astro.site,
  dateModified: meta.scrapedAt,
  temporalCoverage: meta.eventDate,
  isBasedOn: meta.sourceUrl,
  creator: { '@type': 'Organization', name: 'Wally Webdev' },
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`Explore ${meta.walkCount} registered Great Global Greyhound Walk events across ${meta.countryCount} countries and territories on an interactive global map.`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Great Global Greyhound Walk 2026 — Global Stats & Map" />
    <meta property="og:description" content={`Explore ${meta.walkCount} registered walks across ${meta.countryCount} countries and territories.`} />
    <meta property="og:url" content={Astro.site} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f04b3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.site} />
    <script type="application/ld+json" is:inline set:html={structuredData}></script>
    <title>Great Global Greyhound Walk 2026 — Global Stats & Map</title>
  </head>
  <body>
    <a class="skip-link" href="#map-section">Skip to the map</a>
    <header class="hero">
      <nav class="topbar" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="GGGW stats home">
          <span class="brand-mark" aria-hidden="true">G</span>
          <span>GGGW 2026<br />Global statistics</span>
        </a>
        <div class="nav-links">
          <a href="#countries">Countries</a>
          <a href="#map-section">Map</a>
          <a href="#walks">Walks</a>
        </div>
      </nav>

      <aside class="independence-notice" aria-label="Independent website notice">
        <div>
          <strong>Independent project — not the official Great Global Greyhound Walk website.</strong>
          <span>This site is made by an individual and independently uses publicly available data from the official website.</span>
        </div>
        <a href="https://greatglobalgreyhoundwalk.co.uk/" target="_blank" rel="noopener">Visit the official website <span aria-hidden="true">↗</span></a>
      </aside>

      <div id="top" class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Great Global Greyhound Walk · 27 September 2026</p>
          <h1>Global walk<br /><em>dashboard.</em></h1>
          <p class="intro">Explore every currently registered 2026 walk, compare countries and find event details on one practical dashboard.</p>
          <a class="hero-cta" href="#map-section">View interactive map <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-figure" aria-hidden="true">
          <img src="/images/global-greyhound-hero.png" width="1024" height="576" alt="" decoding="async" fetchpriority="high" />
        </div>
      </div>

      <div class="ticker" aria-hidden="true">
        <div>GREYHOUNDS ON THE MOVE · GREYHOUNDS ON THE MOVE · GREYHOUNDS ON THE MOVE · GREYHOUNDS ON THE MOVE ·</div>
      </div>
    </header>

    <main>
      <section class="numbers" aria-labelledby="numbers-title">
        <div class="section-kicker"><span>01</span><p id="numbers-title">The global picture</p></div>
        <div class="stat-grid">
          <article class="stat stat-primary">
            <strong>{meta.walkCount}</strong>
            <span>registered<br />walks</span>
          </article>
          <article class="stat">
            <strong>{meta.countryCount}</strong>
            <span>countries &<br />territories</span>
          </article>
          <article class="stat">
            <strong>{shortWalks}</strong>
            <span>with a shorter<br />route available</span>
          </article>
          <article class="stat">
            <strong>{accessibleWalks}</strong>
            <span>marked buggy &<br />wheelchair suitable</span>
          </article>
        </div>
        <p class="data-note">Based on the official 2026 schedule. Listings change as new walks register. Markers are geocoded from each published venue or meeting point and may be approximate. Last collected {updated}.</p>
      </section>

      <section id="countries" class="countries" aria-labelledby="countries-title">
        <div class="section-kicker light"><span>02</span><p>Where the walks are</p></div>
        <div class="section-heading">
          <h2 id="countries-title">Countries &amp;<br /><em>territories</em></h2>
          <p>{leadingCountry.country} currently leads with {leadingCountry.count} walks. Select any country to isolate its markers and listings.</p>
        </div>
        <div class="country-layout">
          <div class="country-bars" aria-label="Top countries by walk count">
            {countries.slice(0, 8).map((item, index) => (
              <button class="country-bar" data-country={item.country} style={`--size:${item.count / countries[0].count}; --delay:${index * 60}ms`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{item.country}</strong>
                <i aria-hidden="true"></i>
                <b>{item.count}</b>
              </button>
            ))}
          </div>
          <div class="country-table-wrap">
            <table>
              <caption>All countries and territories</caption>
              <thead><tr><th scope="col">Country / territory</th><th scope="col">Walks</th></tr></thead>
              <tbody>
                {countries.map((item) => (
                  <tr><th scope="row"><button data-country={item.country}>{item.country}</button></th><td>{item.count}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="map-section" class="map-section" aria-labelledby="map-title">
        <div class="section-kicker"><span>03</span><p>Find the pack</p></div>
        <div class="map-heading">
          <div>
            <h2 id="map-title">Walk locations</h2>
            <p>Use the mouse wheel over the map to zoom. Pan, filter by country, or select a marker for details.</p>
          </div>
          <div class="map-controls">
            <label for="country-filter">Filter country</label>
            <select id="country-filter">
              <option value="all">All countries</option>
              {countries.map((item) => <option value={item.country}>{item.country} ({item.count})</option>)}
            </select>
            <button id="reset-map" type="button">Reset map</button>
          </div>
        </div>
        <div class="map-frame">
          <div class="map-counter"><strong id="visible-map-count">{mappedWalks.length}</strong><span>walks<br />on map</span></div>
          <div id="walk-map" role="region" aria-label="Interactive map of registered Great Global Greyhound Walks"></div>
        </div>
        {meta.mappedCount < meta.walkCount && <p class="map-caveat">{meta.walkCount - meta.mappedCount} listing(s) could not be mapped from the published location details.</p>}
      </section>

      <section id="walks" class="walk-directory" aria-labelledby="walks-title">
        <div class="section-kicker light"><span>04</span><p>The full roll call</p></div>
        <div class="directory-heading">
          <h2 id="walks-title">Registered walks</h2>
          <div class="search-wrap">
            <label for="walk-search">Search location, postcode or organiser</label>
            <input id="walk-search" type="search" placeholder="Try ‘Dayboro’ or ‘Bristol’" autocomplete="off" />
          </div>
        </div>
        <p class="result-count" aria-live="polite"><strong id="visible-list-count">{walks.length}</strong> walks found</p>
        <div class="walk-list" id="walk-list">
          {walks.map((walk, index) => (
            <article class="walk-card" data-country={walk.country} data-search={`${walk.title} ${walk.postcode} ${walk.organiser} ${walk.leader}`.toLowerCase()}>
              <span class="walk-number">{String(index + 1).padStart(3, '0')}</span>
              <div class="walk-place">
                <p>{walk.country}{walk.region && ` · ${walk.region}`}</p>
                <h3>{walk.locality}</h3>
              </div>
              <dl>
                <div><dt>Starts</dt><dd>{walk.startTime || 'See listing'}</dd></div>
                <div><dt>Postcode</dt><dd>{walk.postcode || '—'}</dd></div>
              </dl>
              <a href={walk.sourceUrl} target="_blank" rel="noopener">Official details <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <button id="show-more" class="show-more" type="button">Show 20 more walks</button>
        <p id="no-results" class="no-results" hidden>No walks match that search yet.</p>
      </section>
    </main>

    <footer>
      <div class="footer-mark">G</div>
      <div>
        <p>An independent visualisation of publicly listed Great Global Greyhound Walk data.</p>
        <p>Not an official GGGW website. Always confirm details on the official listing before travelling.</p>
      </div>
      <a href={meta.sourceUrl} target="_blank" rel="noopener">View official schedule ↗</a>
    </footer>

    <script id="walk-data" type="application/json" is:inline set:html={safeJson}></script>
    <script>
      import L from 'leaflet';

      type WalkLocation = { lat: number; lng: number };
      type Walk = {
        id: string;
        title: string;
        country: string;
        locality: string;
        region: string;
        address: string;
        postcode: string;
        startTime: string;
        duration: string;
        walkType: string;
        organiser: string;
        shortWalk: string;
        accessible: string;
        refreshments: string;
        location: WalkLocation;
        sourceUrl: string;
      };

      const dataElement = document.querySelector<HTMLScriptElement>('#walk-data');
      const walks: Walk[] = JSON.parse(dataElement?.textContent ?? '[]');
      const map = L.map('walk-map', { scrollWheelZoom: false, minZoom: 2, worldCopyJump: true });
      const mapElement = document.querySelector<HTMLElement>('#walk-map');
      const initialBounds = L.latLngBounds(walks.map((walk) => [walk.location.lat, walk.location.lng]));

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
      }).addTo(map);

      const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character] ?? character);
      const markerIcon = L.divIcon({ className: 'walk-marker-wrap', html: '<span class="walk-marker"></span>', iconSize: [24, 24], iconAnchor: [12, 12], popupAnchor: [0, -14] });
      const markers = new Map<string, L.Marker>();

      for (const walk of walks) {
        const featureTags = [walk.shortWalk.toLowerCase() === 'yes' ? 'Short route' : '', walk.accessible.toLowerCase() === 'yes' ? 'Accessible' : '', walk.refreshments.toLowerCase() === 'yes' ? 'Refreshments' : ''].filter(Boolean);
        const trustedSourceUrl = /^https:\/\/greatglobalgreyhoundwalk\.co\.uk\/walks\/[a-z0-9-]+\/$/.test(walk.sourceUrl) ? walk.sourceUrl : 'https://greatglobalgreyhoundwalk.co.uk/walk-schedule/';
        const popup = `<article class="map-popup"><p>${escapeHtml(walk.country)}${walk.region ? ` · ${escapeHtml(walk.region)}` : ''}</p><h3>${escapeHtml(walk.locality)}</h3><dl><div><dt>Start</dt><dd>${escapeHtml(walk.startTime || 'See listing')}</dd></div><div><dt>Duration</dt><dd>${escapeHtml(walk.duration || 'See listing')}</dd></div><div><dt>Postcode</dt><dd>${escapeHtml(walk.postcode || '—')}</dd></div>${walk.organiser ? `<div><dt>Organiser</dt><dd>${escapeHtml(walk.organiser)}</dd></div>` : ''}</dl>${featureTags.length ? `<div class="popup-tags">${featureTags.map((tag) => `<span>${tag}</span>`).join('')}</div>` : ''}<a href="${trustedSourceUrl}" target="_blank" rel="noopener">Open official listing ↗</a></article>`;
        const marker = L.marker([walk.location.lat, walk.location.lng], { icon: markerIcon, title: walk.title }).bindPopup(popup, { maxWidth: 320 });
        marker.addTo(map);
        markers.set(walk.id, marker);
      }

      if (initialBounds.isValid()) map.fitBounds(initialBounds, { padding: [30, 30] });
      if (mapElement) {
        const syncZoom = () => { mapElement.dataset.zoom = String(map.getZoom()); };
        let wheelDelta = 0;
        let wheelTimer: number | undefined;
        map.on('zoomend', syncZoom);
        syncZoom();
        mapElement.addEventListener('wheel', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const deltaScale = event.deltaMode === WheelEvent.DOM_DELTA_LINE
            ? 16
            : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
              ? mapElement.clientHeight
              : 1;
          wheelDelta += event.deltaY * deltaScale;
          window.clearTimeout(wheelTimer);
          wheelTimer = window.setTimeout(() => {
            if (wheelDelta !== 0) {
              const nextZoom = map.getZoom() + (wheelDelta < 0 ? 1 : -1);
              map.setZoom(Math.max(map.getMinZoom(), Math.min(map.getMaxZoom(), nextZoom)), { animate: true });
            }
            wheelDelta = 0;
          }, 28);
        }, { passive: false, capture: true });
      }
      const countrySelect = document.querySelector<HTMLSelectElement>('#country-filter');
      const count = document.querySelector<HTMLElement>('#visible-map-count');
      const search = document.querySelector<HTMLInputElement>('#walk-search');
      const listCount = document.querySelector<HTMLElement>('#visible-list-count');
      const noResults = document.querySelector<HTMLElement>('#no-results');
      const showMore = document.querySelector<HTMLButtonElement>('#show-more');
      let activeCountry = 'all';
      let visibleLimit = 20;

      const filterListings = () => {
        const query = search?.value.trim().toLowerCase() ?? '';
        let matches = 0;
        document.querySelectorAll<HTMLElement>('.walk-card').forEach((card) => {
          const matchesCountry = activeCountry === 'all' || card.dataset.country === activeCountry;
          const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
          const matchesFilters = matchesCountry && matchesQuery;
          const show = matchesFilters && matches < visibleLimit;
          card.hidden = !show;
          if (matchesFilters) matches += 1;
        });
        if (listCount) listCount.textContent = String(matches);
        if (noResults) noResults.hidden = matches !== 0;
        if (showMore) showMore.hidden = matches <= visibleLimit;
      };

      const filterCountry = (country: string) => {
        activeCountry = country;
        visibleLimit = 20;
        const visible: L.LatLngExpression[] = [];
        for (const walk of walks) {
          const marker = markers.get(walk.id);
          if (!marker) continue;
          const show = country === 'all' || walk.country === country;
          if (show) {
            marker.addTo(map);
            visible.push([walk.location.lat, walk.location.lng]);
          } else marker.removeFrom(map);
        }
        if (count) count.textContent = String(visible.length);
        if (countrySelect) countrySelect.value = country;
        filterListings();
        if (visible.length) map.fitBounds(L.latLngBounds(visible), { padding: [40, 40], maxZoom: country === 'all' ? 5 : 8 });
      };

      countrySelect?.addEventListener('change', () => filterCountry(countrySelect.value));
      document.querySelector('#reset-map')?.addEventListener('click', () => filterCountry('all'));
      document.querySelectorAll<HTMLButtonElement>('button[data-country]').forEach((button) => button.addEventListener('click', () => {
        const country = button.dataset.country ?? 'all';
        filterCountry(country);
        document.querySelector('#map-section')?.scrollIntoView({ behavior: 'smooth' });
      }));
      search?.addEventListener('input', () => {
        visibleLimit = 20;
        filterListings();
      });
      showMore?.addEventListener('click', () => {
        visibleLimit += 20;
        filterListings();
      });
      filterListings();
    </script>
  </body>
</html>
